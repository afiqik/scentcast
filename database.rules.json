{
  "rules": {
    "sensors": {
      ".read": true,
      ".write": false,
      "currentWeather": {
        ".read": true,
        ".write": true
      }
    },
    "presence": {
      ".read": true,
      ".write": false,
      "activeUsers": {
        ".read": true,
        "$uid": {
          ".write": true
        }
      }
    },
    "weather": {
      ".read": true,
      ".write": false,
      "activeCity": {
        ".write": true
      },
      "cities": {
        ".write": true
      }
    },
    ".read": false,
    ".write": false
  }
}
